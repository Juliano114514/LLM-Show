# Publish only the selected source, native libraries, rules and newest results.
/*
!/.gitignore
!/LICENSE
!/README.md
!/frontend/
!/qq-show-classic/
!/qq-show-fashion/
!/LLM-show-classic/
!/LLM-show-fashion/

/LLM-show-classic/*
!/LLM-show-classic/preview.png
!/LLM-show-classic/rating-rules/
!/LLM-show-classic/results/
/LLM-show-classic/results/*
!/LLM-show-classic/results/newest/

/LLM-show-fashion/*
!/LLM-show-fashion/preview.png
!/LLM-show-fashion/rating-rules/
!/LLM-show-fashion/results/
/LLM-show-fashion/results/*
!/LLM-show-fashion/results/newest/

**/node_modules/
**/dist/
**/.vite/
**/.vite-cache/
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
!**/.env.example
**/.keep-awake
