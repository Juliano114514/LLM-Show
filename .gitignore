# Publish only the selected source, native libraries, rules and newest results.
/*
!/.gitignore
!/LICENSE
!/README.md
!/workplace/
/workplace/*
!/workplace/frontend/
!/workplace/LLM-show-classic/
!/workplace/LLM-show-fashion/
!/qq-show-classic/
!/qq-show-fashion/

/workplace/LLM-show-classic/*
!/workplace/LLM-show-classic/preview.png
!/workplace/LLM-show-classic/rating-rules/
!/workplace/LLM-show-classic/results/
/workplace/LLM-show-classic/results/*
!/workplace/LLM-show-classic/results/newest/

/workplace/LLM-show-fashion/*
!/workplace/LLM-show-fashion/preview.png
!/workplace/LLM-show-fashion/rating-rules/
!/workplace/LLM-show-fashion/results/
/workplace/LLM-show-fashion/results/*
!/workplace/LLM-show-fashion/results/newest/

**/node_modules/
**/dist/
**/.vite/
**/.vite-cache/
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
!**/.env.example
**/.keep-awake
